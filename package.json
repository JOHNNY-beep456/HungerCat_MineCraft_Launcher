{
  "name": "hunger-cat-minecraft-launcher",
  "version": "0.7.3-beta1",
  "description": "HungerCat MineCraft Launcher",
  "main": "./out/main/index.js",
  "author": "Hunger Cat",
  "homepage": "https://github.com/JOHNNY-beep456/HungerCat_MineCraft_Launcher",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:update": "node scripts/test-update-resolve.mjs",
    "test:lyrics": "node scripts/test-lyrics.mjs",
    "test:lifecycle": "node scripts/test-window-lifecycle.mjs",
    "test:layout": "node scripts/test-settings-layout.mjs",
    "test:rows": "node scripts/test-custom-rows.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:smtc": "node scripts/test-smtc-ascii.mjs && node scripts/test-smtc-live.mjs",
    "native:build": "node scripts/build-native-downloader.mjs",
    "native:build:debug": "node scripts/build-native-downloader.mjs --debug",
    "fix:integrity": "node scripts/fix-artifact-integrity.mjs",
    "win": "electron-vite build && electron-builder --win && node scripts/fix-artifact-integrity.mjs",
    "dist": "electron-vite build && electron-builder --win && node scripts/fix-artifact-integrity.mjs",
    "dist:win": "electron-vite build && electron-builder --win && node scripts/fix-artifact-integrity.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "marked": "^15.0.7",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
