{
  "name": "hunger-cat-minecraft-launcher",
  "version": "0.8.3",
  "description": "HungerCat MineCraft Launcher",
  "main": "./out/main/index.js",
  "author": "Hunger Cat",
  "homepage": "https://github.com/JOHNNY-beep456/HungerCat_MineCraft_Launcher",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "tauri dev",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "dev:tauri:web": "vite --config vite.tauri.config.mts",
    "build:tauri:web": "vite build --config vite.tauri.config.mts",
    "build:tauri": "tauri build",
    "android:dev": "node scripts/prepare-tauri-android.mjs && tauri android dev",
    "android:runtime": "node scripts/prepare-android-runtime.mjs",
    "android:build": "node scripts/prepare-tauri-android.mjs && npm run android:runtime && tauri android build",
    "android:build:arm64": "node scripts/prepare-tauri-android.mjs && node scripts/prepare-android-runtime.mjs arm64 && node scripts/build-android-boot.mjs && tauri android build --target aarch64 --apk",
    "android:build:x86": "node scripts/prepare-tauri-android.mjs && node scripts/prepare-android-runtime.mjs x86 && node scripts/build-android-boot.mjs && tauri android build --target i686 --apk",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test:lifecycle": "node scripts/test-window-lifecycle.mjs",
    "test:rows": "node scripts/test-custom-rows.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "fix:integrity": "node scripts/fix-artifact-integrity.mjs",
    "fix:integrity:all": "node scripts/fix-artifact-integrity.mjs --project"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "marked": "^15.0.7",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
