<Application x:Class="PCCL2.Native.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- 来源与适配边界见 reference/STYLE-SOURCES.md；固定 PCL 提交 93ede5d9。 -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Upstream/PclPalette.xaml"/>
        <ResourceDictionary Source="Upstream/PclStandardTemplates.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    <!-- 保留既有 Blue 键，颜色取自上游 ColorObject3。 -->
    <SolidColorBrush x:Key="Blue" Color="{StaticResource ColorObject3}"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource ColorBrush1}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource ColorBrushHalfWhite}"/><Setter Property="Foreground" Value="{StaticResource ColorBrush2}"/><Setter Property="BorderBrush" Value="{StaticResource ColorBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
          <Grid><Border x:Name="Hover" Background="#E0EAFD" CornerRadius="2" Opacity="0" Margin="-4"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/></Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ColorBrush3}"/><Setter Property="Foreground" Value="{StaticResource ColorBrush3}"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource ColorBrush7}"/>
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.955" Duration="0:0:0.08"/><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.955" Duration="0:0:0.08"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"/><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{StaticResource ColorBrush3}"/><Setter Property="BorderBrush" Value="{StaticResource ColorBrush3}"/><Setter Property="Background" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="5,0"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="27"/><Setter Property="Padding" Value="12,3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavFrame" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavFrame" Property="Background" Value="#35FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavFrame" Property="Background" Value="{StaticResource ColorBrushHalfWhite}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavFrame" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7,4"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource ColorBrush1}"/><Setter Property="Background" Value="{StaticResource ColorBrushHalfWhite}"/><Setter Property="BorderBrush" Value="{StaticResource ColorBrush5}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="SelectionBrush" Value="{StaticResource ColorBrush3}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" CornerRadius="3" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ColorBrush4}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ColorBrush3}"/><Setter Property="Background" Value="{StaticResource ColorBrush7}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Foreground" Value="{StaticResource ColorBrush1}"/><Setter Property="Background" Value="{StaticResource ColorBrushHalfWhite}"/><Setter Property="BorderBrush" Value="{StaticResource ColorBrush5}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MaxDropDownHeight" Value="320"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <Border x:Name="Frame" CornerRadius="3" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"/>
        <!-- 直接使用上游 Application.xaml 的 ToggleButton 模板和旋转动画。 -->
        <ToggleButton Style="{StaticResource {x:Type ToggleButton}}" Margin="0,0,1.5,0" Foreground="{TemplateBinding BorderBrush}" Focusable="False" IsTabStop="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
        <ContentPresenter Margin="8.5,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}"><Border CornerRadius="3" Background="White" BorderBrush="{StaticResource ColorBrush3}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ColorBrush4}"/><Setter Property="Background" Value="{StaticResource ColorBrush7}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ColorBrush3}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- 原文上游模板负责内容呈现；本地触发器保留标准控件的键盘/鼠标选中反馈。 -->
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MyComboBoxItem}">
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource ColorBrush7}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource ColorBrush8}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}" Margin="0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource ColorBrush8}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource ColorBrush7}"/><Setter Property="Foreground" Value="{StaticResource ColorBrush3}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#F5FFFFFF"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="20"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#343D4A"/></Setter.Value></Setter></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
