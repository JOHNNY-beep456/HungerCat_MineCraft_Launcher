resources/native
# Rust 构建缓存与产物。
native/*/target
/src-tauri/target/
# `npx tauri icon` 的临时输出目录（正式图标已复制到 icons/ 根下）。
/src-tauri/icons/generated/
/src-tauri/gen/schemas/
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/.kotlin/
/src-tauri/gen/android/**/build/
# Android 运行时：JRE 原生库与类库镜像由 scripts/prepare-android-runtime.mjs 从 .local 生成，
# 属可再生成物且体积上百 MB，不进 Git。
/src-tauri/gen/android/app/src/main/assets/runtime/
/src-tauri/gen/android/app/src/main/jniLibs/
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/keystore.properties
/src-tauri/gen/android/*.jks
/src-tauri/gen/android/*.keystore
